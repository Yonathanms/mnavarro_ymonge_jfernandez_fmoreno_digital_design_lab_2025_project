-- Datos de inicializacion para ROM - FASE 0
-- Programa que hace parpadear LED[4] alternando entre bit[4]=0 y bit[4]=1

WIDTH=32;
DEPTH=1024;

ADDRESS_RADIX=UNS;
DATA_RADIX=HEX;

CONTENT BEGIN
    -- Direcciones 0-3: Instrucciones de prueba (bit[4] = 0)
    0    : E0801000;  -- ADD R1, R0, R0
    1    : E0811001;  -- ADD R1, R1, R1
    2    : E5801000;  -- STR R1, [R0, #0]
    3    : E5902000;  -- LDR R2, [R0, #0]

    -- Direccion 4: Salto a direccion 16 (para cambiar bit[4] a 1)
    -- pc_next = pc_plus4 + offset = 20 + offset = 64
    -- offset = 44 = 0x2C
    4    : EA00002C;  -- B +0x2C (salta a direccion 16)

    -- Relleno hasta direccion 16
    [5..15] : 00000000;

    -- Direcciones 16-19: Instrucciones similares (bit[4] = 1)
    16   : E0801000;  -- ADD R1, R0, R0
    17   : E0811001;  -- ADD R1, R1, R1
    18   : E5801000;  -- STR R1, [R0, #0]
    19   : E5902000;  -- LDR R2, [R0, #0]

    -- Direccion 20: Salto de vuelta a direccion 0
    -- pc_next = pc_plus4 + offset = 84 + offset = 0
    -- offset = -84 = 0xFFFFAC (complemento a 2)
    20   : EAFFFFAC;  -- B -0x54 (salta de vuelta a direccion 0)

    -- Relleno final
    [21..1023] : 00000000;
END;
